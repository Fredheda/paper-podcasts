# OS / editor
.DS_Store

# Env / secrets. frontend/.env.production is tracked on purpose (it holds only
# a public API base URL); an ignore pattern does not untrack a tracked file.
.env
.env*
!.env.example
!frontend/.env.production
*.pem
*.key
*.p12
*.pfx
local.settings.json
terraform.tfstate
terraform.tfstate.*
.azure/

# Python
__pycache__
*.py[cod]
.pytest_cache/
.ruff_cache/
requirements.txt
.venv/
venv/

# Logs
npm-debug.log*
*.log

# Editors
.idea/
.vscode/

# Generated artifacts
*.pdf
*.mp3
data/*
summaries/*
extracted_content/*

# Notebooks / experiments
notebooks/.DS_Store
notebooks/papers/*
notebooks/downloads/*
notebooks/audio/*
notebooks/extracted_content/*
notebooks/summaries/*
notebooks/experimentation.ipynb
notebooks/anthropic_experimentation.ipynb
langgraph.ipynb
graph.mmd

# Legacy / examples
legacy/*
streamlit/legacy/*
streamlit/examples/*
examples/data/*
examples/papers/*

# Local docs / local overrides
src/services/llm_service.py

# Frontend build artifacts
frontend/node_modules
frontend/dist
frontend/.vite
frontend/tsconfig.tsbuildinfo
